{
	"name": "setup-infisical",
	"version": "1.0.0",
	"private": true,
	"description": "GitHub Action to install the Infisical CLI",
	"license": "MIT",
	"author": "Jacob Hands",
	"type": "module",
	"scripts": {
		"all": "run-s format:check lint typecheck deps:check knip test bundle",
		"bundle": "run-s bundle:js bundle:licenses",
		"bundle:js": "esbuild src/bin/setup-infisical.bin.ts --bundle --platform=node --target=node24 --format=esm --minify --legal-comments=none --keep-names --banner:js=\"import { createRequire as __createRequire } from 'node:module'; const require = __createRequire(import.meta.url);\" --outfile=dist/index.js",
		"bundle:licenses": "generate-license-file --input package.json --output dist/licenses.txt --overwrite --ci --no-spinner --eol lf",
		"coverage": "vitest run --coverage",
		"deps:check": "syncpack lint",
		"deps:fix": "syncpack fix",
		"deps:update": "syncpack update",
		"fix": "run-s deps:fix lint:fix format",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"postinstall": "hk install",
		"knip": "knip",
		"lint": "oxlint --type-aware --max-warnings=0 .",
		"lint:fix": "oxlint --type-aware --fix .",
		"local-action": "local-action . src/main.ts .env",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@actions/cache": "6.2.0",
		"@actions/core": "3.0.1",
		"@actions/http-client": "4.0.1",
		"@actions/tool-cache": "4.0.0",
		"better-result": "2.10.0",
		"semver": "7.8.5",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@github/local-action": "7.0.1",
		"@ianvs/prettier-plugin-sort-imports": "4.7.1",
		"@types/node": "24.13.3",
		"@types/semver": "7.7.1",
		"@vitest/coverage-v8": "4.1.10",
		"esbuild": "0.28.1",
		"generate-license-file": "4.2.1",
		"knip": "6.29.0",
		"npm-run-all2": "9.0.2",
		"oxlint": "1.75.0",
		"oxlint-tsgolint": "7.0.2001",
		"prettier": "3.9.6",
		"prettier-plugin-packagejson": "3.0.2",
		"syncpack": "15.3.2",
		"typescript": "6.0.3",
		"vitest": "4.1.10"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"knip": {
		"ignoreBinaries": [
			"hk"
		]
	}
}
